{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{application=\"settleup-api\"}[5m]))", "legendFormat": "requests/sec"}]
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"settleup-api\"}[5m])))", "legendFormat": "p95"}]
    },
    {
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{application=\"settleup-api\",status=~\"5..\"}[5m]))", "legendFormat": "5xx/sec"}]
    },
    {
      "type": "timeseries",
      "title": "JVM heap",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{application=\"settleup-api\",area=\"heap\"})", "legendFormat": "used"}, {"expr": "sum(jvm_memory_max_bytes{application=\"settleup-api\",area=\"heap\"})", "legendFormat": "max"}]
    },
    {
      "type": "timeseries",
      "title": "Database pool",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [{"expr": "sum(hikaricp_connections_active{application=\"settleup-api\"})", "legendFormat": "active"}, {"expr": "sum(hikaricp_connections_idle{application=\"settleup-api\"})", "legendFormat": "idle"}]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["settleup"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "SettleUp overview",
  "uid": "settleup-overview",
  "version": 1
}
